# Copy to deploy/production.env only on your server; chmod 600.
# No secret below belongs in Git, frontend code, NEXT_PUBLIC_*, or a chat message.
APP_DOMAIN=
ACME_EMAIL=
BACKUP_DIRECTORY=
CADDY_CONFIG_FILE=./Caddyfile
# One worker/replica, shared workspace with individual accounts.
# Generate privately with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
APP_API_TOKEN=
GEMINI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite
WEBSITE_ALLOWED_HOSTS=
WEBSITE_DNS_OVER_HTTPS=false
WEBSITE_FOLLOW_REDIRECTS=false
# Set after native n8n setup, or point to an existing public HTTPS n8n instance.
N8N_BASE_URL=
N8N_API_KEY=
# Optional bundled n8n: actual separate DNS hostname + private long random key.
N8N_DOMAIN=
N8N_ENCRYPTION_KEY=
# Keep false until verified sender, direct signing secret, and owned test recipient.
ENABLE_EMAIL_DELIVERY=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=
