# Copy to deploy/.env only on your deployment machine; keep it private.
# Generate a random shared token and enter it securely. No example token works.
APP_API_TOKEN=
# Replace with your exact HTTPS application hostname, without scheme or port.
APP_ALLOWED_HOSTS=your-app.example.com
# Optional: actual public HTTPS app origin for provider callbacks.
APP_PUBLIC_URL=
PERSISTENCE_BACKEND=sqlite
ENABLE_OUTBOUND_CALLS=false
# Optional reminder email; keep disabled until live setup is verified.
ENABLE_EMAIL_DELIVERY=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Actual signing secret at runtime, not a network proxy placeholder.
RESEND_WEBHOOK_SECRET=
# Optional: approved business-website hostnames, separate from your app hostname.
WEBSITE_ALLOWED_HOSTS=
WEBSITE_DNS_OVER_HTTPS=false
WEBSITE_FOLLOW_REDIRECTS=false
