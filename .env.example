# Safe local defaults and empty credential slots. Never commit your filled .env.
# START-WINDOWS.bat explicitly loads root .env. Other launches need --env-file .env.
APP_API_TOKEN=
# Optional: actual public HTTPS app origin for provider callbacks.
APP_PUBLIC_URL=
APP_ENV=development
APP_ALLOWED_HOSTS=127.0.0.1,localhost
# Windows defaults to local Edge; Linux development defaults to docker.
BROWSER_RUNTIME=local
SCRAPE_OUTPUT_DIR=.local/scrapes
PERSISTENCE_BACKEND=sqlite
APP_DB_PATH=.local/backend.sqlite3
GOOGLE_PLACES_API_KEY=
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Native inquiry automation: private server origin/key. Use HTTPS when hosted.
N8N_BASE_URL=
N8N_API_KEY=
# Level 1 sender name, company and offer are entered per draft request; no sender secret is stored here.
WEBSITE_ALLOWED_HOSTS=
WEBSITE_DNS_OVER_HTTPS=false
WEBSITE_FOLLOW_REDIRECTS=false
SUPABASE_URL=
SUPABASE_KEY=
ENABLE_EMAIL_DELIVERY=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=
ENABLE_OUTBOUND_CALLS=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SALES_AGENT_NUMBER=
